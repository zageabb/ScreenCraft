# Do not commit real passwords, setup keys or GitHub tokens.
SCREENCRAFT_DB_PASSWORD=replace-with-long-random-password
SCREENCRAFT_SECRET_KEY=replace-with-cryptographically-random-secret
SCREENCRAFT_SETUP_KEY=replace-with-temporary-setup-secret
SCREENCRAFT_ALLOWED_REPOS=zageabb/example-app
SCREENCRAFT_GITHUB_TOKEN=

# UDA integration (leave local until verified UDA identity forwarding is configured)
SCREENCRAFT_AUTH_MODE=local
SCREENCRAFT_UDA_IDENTITY_HEADER=X-UDA-User
SCREENCRAFT_UDA_PROXY_SECRET=


# Optional ScreenCraft AI assistant: private backend-to-Ollama connection only.
SCREENCRAFT_OLLAMA_URL=http://192.168.1.249:11434
SCREENCRAFT_OLLAMA_MODEL=gpt-oss:120b-cloud
# The cloud-model tag may transmit design context outside the private network.
